{% extends 'base.html.twig' %}

{% block title %}{{ user.fullName }}{% endblock %}

{% block body %}
<div class="wrapper">
    <h1>{{ user.fullName }}</h1>

    <table>
        <tbody>
            <tr><th>ID</th><td>{{ user.id }}</td></tr>
            <tr><th>Email</th><td>{{ user.email }}</td></tr>
            <tr><th>Prénom</th><td>{{ user.firstName }}</td></tr>
            <tr><th>Nom</th><td>{{ user.lastName }}</td></tr>
            <tr><th>Rôle</th><td>{{ user.role }}</td></tr>
            <tr><th>Rôles de sécurité</th><td>{{ user.roles|join(', ') }}</td></tr>
            <tr><th>Créé le</th><td>{{ user.createdAt ? user.createdAt|date('d/m/Y H:i') : '' }}</td></tr>
        </tbody>
    </table>

    <a href="{{ path('app_user_index') }}">Retour à la liste</a>
    <a href="{{ path('app_user_edit', {id: user.id}) }}">Modifier</a>
    {{ include('user/_delete_form.html.twig') }}
</div>
{% endblock %}
